# Copy to .env.local for `vercel dev`. In production, set these in the
# Vercel dashboard: Project -> Settings -> Environment Variables.

# Required for /api/transcribe and /api/ask.
# Get a free key (no credit card) at https://console.groq.com/keys
# This is NOT an OpenAI key — Groq hosts the real open-source Whisper and
# Llama model weights on their own hardware with a genuine free tier.
GROQ_API_KEY=gsk_...

# Optional overrides — defaults shown are what the code uses if unset.
# Check https://console.groq.com/docs/models for current free-tier model
# availability if either of these ever gets deprecated.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Auto-added by Vercel once you create a Blob store and connect it to this
# project (Storage tab -> Create Database -> Blob). You normally never set
# this by hand; `vercel env pull` will fetch it into .env.local for you.
BLOB_READ_WRITE_TOKEN=

# The exact origin your frontend is served from. If the frontend and API
# are deployed together in this same project (the default setup below),
# you can leave this as * — everything is same-origin and CORS doesn't
# even come into play. Only tighten this if you split them across two
# different Vercel projects/domains.
ALLOWED_ORIGIN=*
